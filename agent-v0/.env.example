# Service
APP_NAME=EnterpriseAgent
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge

# Embeddings: local works without an API key.
# Use "openai" with an OpenAI-compatible embeddings endpoint for production.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenAI-compatible chat model. Without a key, a grounded
# extractive responder is used so the demo remains fully runnable.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Knowledge and persistence
AUTO_SEED=true
SEED_TICKETS=true
MIN_RELEVANCE=0.1
CORS_ORIGINS=*

