# Service
APP_NAME=EnterpriseAgent
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge

# Embeddings: "pretrained" runs the local Chinese BGE ONNX model (no API key),
# "local" keeps the dependency-free hashing baseline, and "openai" targets an
# OpenAI-compatible embeddings endpoint.
EMBEDDING_PROVIDER=pretrained
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=16
# Override the ONNX model cache location (default: <project>/models/<model>).
EMBEDDING_MODEL_DIR=

# Optional OpenAI-compatible chat model. Without a key, a grounded
# extractive responder is used so the demo remains fully runnable.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Knowledge and persistence
AUTO_SEED=true
SEED_TICKETS=true
MIN_RELEVANCE=0.1
CORS_ORIGINS=*

