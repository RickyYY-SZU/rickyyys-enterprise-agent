# Service
APP_NAME=EnterpriseAgent
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge

# Embeddings: local works without an API key.
# Use "openai" with an OpenAI-compatible embeddings endpoint for production.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=text-embedding-3-small

# Optional OpenAI-compatible chat model. Without a key, a grounded
# extractive responder is used so the demo remains fully runnable.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Tracing: structured spans per graph node, tool, and LLM call.
# Traces are logged as JSON, kept in a bounded in-memory buffer served by
# /api/traces, and exported to an OTLP collector when an endpoint is set.
TRACING_ENABLED=true
TRACING_LOG_SPANS=true
TRACING_MAX_RECORDS=200
# Include trace_id in /api/chat responses to correlate user reports with traces.
TRACING_INCLUDE_IN_RESPONSE=false
# e.g. http://localhost:4318/v1/traces (requires opentelemetry packages)
TRACING_OTLP_ENDPOINT=

# LangSmith: LangGraph nodes are LangChain runnables, so setting these env
# vars exports per-node runs without any code change.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-agent

# Knowledge and persistence
AUTO_SEED=true
SEED_TICKETS=true
MIN_RELEVANCE=0.1
CORS_ORIGINS=*

